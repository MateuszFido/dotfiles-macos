#!/bin/bash
# SketchyBar: Rift workspaces on the left, status pills on the right.
# Colors come from Pywal16 (colors.sh); Rift pushes rift_update (rift/config.toml run_on_start).

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
. "$CONFIG_DIR/colors.sh"
. "$CONFIG_DIR/icons.sh"

FONT="JetBrainsMono Nerd Font"
APP_FONT="sketchybar-app-font:Regular:14.0"
RIFT=/opt/homebrew/bin/rift-cli

# Native-menu helper (helpers/menubar.swift): rebuilt on first run or after edits.
MENUBAR="$CONFIG_DIR/helpers/menubar"
[ "$MENUBAR.swift" -nt "$MENUBAR" ] && xcrun swiftc -O "$MENUBAR.swift" -o "$MENUBAR"
CONTROL_CENTER="$MENUBAR extra com.apple.menuextra.controlcenter"

sketchybar --bar position=top height=34 margin=6 y_offset=2 color=$TRANSPARENT \
	padding_left=0 padding_right=0 sticky=on shadow=off display=all

sketchybar --default \
	updates=when_shown \
	icon.font="$FONT:Bold:14.0" icon.color=$ACCENT icon.padding_left=6 icon.padding_right=3 \
	label.font="$FONT:Bold:13.0" label.color=$FG label.padding_left=3 label.padding_right=6 \
	background.height=24 background.corner_radius=7 \
	padding_left=1 padding_right=1

PILL_STYLE=(background.color=$PILL background.height=30 background.corner_radius=10)

# ---------- left: apple + workspaces ----------
sketchybar --add item apple left \
	--set apple icon="$ICON_APPLE" icon.font="$FONT:Bold:16.0" icon.padding_left=10 icon.padding_right=8 \
	label.drawing=off click_script="$MENUBAR press 0"

for i in 1 2 3 4 5 6 7 8 9; do
	sketchybar --add item space.$i left \
		--set space.$i icon=$i icon.color=$DIM icon.padding_left=8 icon.padding_right=4 \
		label.font="$APP_FONT" label.padding_left=2 label.padding_right=8 label.y_offset=-1 label.drawing=off \
		background.color=$ACCENT_BG background.drawing=off \
		click_script="$RIFT execute workspace switch $((i - 1))"
done

sketchybar --add event rift_update \
	--add item rift left \
	--set rift drawing=off updates=on script="$PLUGIN_DIR/rift.sh" \
	--subscribe rift rift_update front_app_switched display_change system_woke

sketchybar --add bracket spaces apple '/space\..*/' --set spaces "${PILL_STYLE[@]}"

# ---------- left: focused app (click: its File/Edit/... menus) ----------
sketchybar --add item front_app left \
	--set front_app icon.font="$APP_FONT" icon.color=$ACCENT padding_left=8 \
	background.color=$PILL background.height=30 background.corner_radius=10 \
	icon.padding_left=10 label.padding_right=10 script="$PLUGIN_DIR/front_app.sh" \
	popup.align=left popup.y_offset=4 popup.background.color=$PILL popup.background.corner_radius=10 \
	--subscribe front_app front_app_switched mouse.clicked mouse.exited.global

# ---------- right: clock (rightmost), then status pill ----------
sketchybar --add item clock right \
	--set clock icon="$ICON_CLOCK" icon.padding_left=10 label.padding_right=10 update_freq=10 \
	background.color=$PILL background.height=30 background.corner_radius=10 \
	script="$PLUGIN_DIR/clock.sh" click_script="open -a Calendar" \
	--add item gap right --set gap width=6

sketchybar --add item battery right \
	--set battery update_freq=60 label.padding_right=10 script="$PLUGIN_DIR/battery.sh" click_script="$CONTROL_CENTER" \
	--subscribe battery power_source_change system_woke

sketchybar --add item wifi right \
	--set wifi update_freq=30 label.drawing=off icon.padding_right=6 script="$PLUGIN_DIR/wifi.sh" click_script="$CONTROL_CENTER" \
	--subscribe wifi wifi_change system_woke

sketchybar --add item volume right \
	--set volume script="$PLUGIN_DIR/volume.sh" click_script="$CONTROL_CENTER" \
	--subscribe volume volume_change

sketchybar --add item cpu right \
	--set cpu icon="$ICON_CPU" icon.padding_left=10 update_freq=4 script="$PLUGIN_DIR/cpu.sh" click_script="$CONTROL_CENTER"

sketchybar --add bracket status cpu volume wifi battery --set status "${PILL_STYLE[@]}"

sketchybar --update
